# Copia este archivo a `.env` y ajusta lo que necesites. `.env` esta git-ignored.
# cp .env.example .env && make up

# ── Postgres local ───────────────────────────────────────────────────────────
POSTGRES_USER=emergency
POSTGRES_PASSWORD=emergency
POSTGRES_DB=emergency
POSTGRES_PORT=5432

# ── Conexion de los servicios ────────────────────────────────────────────────
# UNICA variable que cambia entre local y Supabase. El codigo no distingue.
# Local:    postgresql+asyncpg://emergency:emergency@postgres:5432/emergency
# Supabase: postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://emergency:emergency@postgres:5432/emergency

# ── URLs entre servicios (fases 2-4) ─────────────────────────────────────────
SERVICE_TRANSPORT=http
INTAKE_URL=http://intake:8000
DISPATCH_URL=http://dispatch:8000
GEOSPATIAL_URL=http://geospatial:8000
NOTIFICATION_URL=http://notification:8000
HTTP_TIMEOUT_SECONDS=3

# ── Frontend (fase 5) ────────────────────────────────────────────────────────
# El frontend habla SOLO con el gateway, nunca con los puertos de los servicios.
VITE_API_BASE_URL=http://localhost:8080

# ── Supabase (fase 6) — solo placeholders, nunca las llaves reales ───────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Observabilidad ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO